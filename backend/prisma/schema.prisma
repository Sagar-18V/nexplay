generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MERCHANT
  VIEWER
}

model Merchant {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(MERCHANT)
  apiKey     String   @unique @default(uuid())
  webhookUrl String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  paymentIntents PaymentIntent[]
  settlements    Settlement[]
  webhookLogs    WebhookLog[]
  reconReports   ReconciliationReport[]

  @@map("merchants")
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCESS
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model PaymentIntent {
  id             String        @id @default(uuid())
  merchantId     String
  amount         Int
  currency       String        @default("INR")
  method         PaymentMethod
  status         PaymentStatus @default(CREATED)
  idempotencyKey String        @unique
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  transactions Transaction[]

  @@map("payment_intents")
}

enum Gateway {
  RAZORX
  STRIPEIN
  PAYFLOW
  SWIFTPAY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Transaction {
  id            String            @id @default(uuid())
  intentId      String
  gateway       Gateway
  amount        Int
  status        TransactionStatus @default(PENDING)
  gatewayTxnId  String?
  latencyMs     Int?
  feeAmount     Int?
  failureReason String?
  createdAt     DateTime          @default(now())

  intent         PaymentIntent @relation(fields: [intentId], references: [id])
  ledgerEntries  LedgerEntry[]
  refundedAmount Int           @default(0) // running total of SUCCEEDED refunds
  refunds        Refund[]

  @@map("transactions")
}

model GatewayStat {
  id           String        @id @default(uuid())
  gateway      Gateway
  method       PaymentMethod
  successCount Int           @default(0)
  failureCount Int           @default(0)
  avgLatencyMs Int           @default(0)
  lastUpdated  DateTime      @default(now())

  @@unique([gateway, method])
  @@map("gateway_stats")
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerAccount {
  CUSTOMER_RECEIVABLE
  MERCHANT_PAYABLE
  PLATFORM_REVENUE
  MERCHANT_BANK
}

model LedgerEntry {
  id        String          @id @default(uuid())
  txnId     String
  entryType LedgerEntryType
  account   LedgerAccount
  amount    Int
  createdAt DateTime        @default(now())

  transaction Transaction @relation(fields: [txnId], references: [id])
  refundId    String?
  refund      Refund?     @relation(fields: [refundId], references: [id])

  @@map("ledger_entries")
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
}

model Settlement {
  id             String           @id @default(uuid())
  merchantId     String
  amount         Int
  status         SettlementStatus @default(PENDING)
  gateway        Gateway
  settlementDate DateTime
  createdAt      DateTime         @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("settlements")
}

enum ReconStatus {
  CLEAN
  FLAGGED
}

model ReconciliationReport {
  id            String      @id @default(uuid())
  merchantId    String
  runDate       DateTime
  totalTxns     Int
  matched       Int
  mismatched    Int
  missing       Int
  discrepancies Json?
  status        ReconStatus @default(CLEAN)
  createdAt     DateTime    @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("reconciliation_reports")
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookLog {
  id              String        @id @default(uuid())
  merchantId      String
  event           String
  payload         Json
  attempts        Int           @default(0)
  lastAttemptedAt DateTime?
  deliveredAt     DateTime?
  status          WebhookStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("webhook_logs")
}

enum ReconRunStatus {
  PENDING // parent created, children queued
  IN_PROGRESS // at least one gateway job started
  COMPLETED // all gateway jobs succeeded
  PARTIAL // some succeeded, some exhausted retries
  FAILED // all gateway jobs failed
}

enum ReconJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum DiscrepancyType {
  MISSING_AT_GATEWAY // in our DB, absent from settlement file
  MISSING_IN_DB // in settlement file, we have no record (orphan)
  AMOUNT_MISMATCH // both exist, paise amounts differ
  STATUS_MISMATCH // both exist, status disagrees (we say captured, they say failed)
}

enum DiscrepancyStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  IGNORED // known/accepted difference, e.g. timing cutoff
}

model ReconciliationRun {
  id          String         @id @default(uuid())
  runDate     DateTime       @db.Date // the settlement date being reconciled
  status      ReconRunStatus @default(PENDING)
  startedAt   DateTime       @default(now())
  completedAt DateTime?

  gatewayJobs ReconciliationGatewayJob[]

  @@unique([runDate]) // one run per settlement date
  @@map("reconciliation_runs")
}

model ReconciliationGatewayJob {
  id       String            @id @default(uuid())
  runId    String
  run      ReconciliationRun @relation(fields: [runId], references: [id])
  gateway  Gateway // your existing enum
  status   ReconJobStatus    @default(QUEUED)
  attempts Int               @default(0)

  // summary numbers — the "reconciliation is a report" part
  totalInDb        Int    @default(0) // our payment count for window
  totalInFile      Int    @default(0) // gateway's reported count
  matchedCount     Int    @default(0)
  discrepancyCount Int    @default(0)
  expectedAmount   BigInt @default(0) // sum of our captured amounts, paise
  reportedAmount   BigInt @default(0) // sum from settlement file, paise

  errorMessage String? // last failure reason if FAILED
  startedAt    DateTime?
  completedAt  DateTime?

  discrepancies ReconciliationDiscrepancy[]

  @@unique([runId, gateway]) // one job per gateway per run
  @@map("reconciliation_gateway_jobs")
}

model ReconciliationDiscrepancy {
  id           String                   @id @default(uuid())
  gatewayJobId String
  gatewayJob   ReconciliationGatewayJob @relation(fields: [gatewayJobId], references: [id])

  type   DiscrepancyType
  status DiscrepancyStatus @default(OPEN)

  paymentId     String? // null for MISSING_IN_DB (we have no record)
  gatewayTxnRef String? // gateway's transaction reference from the file

  ourAmount     BigInt? // paise; null if MISSING_IN_DB
  gatewayAmount BigInt? // paise; null if MISSING_AT_GATEWAY
  ourStatus     String?
  gatewayStatus String?

  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([type])
  @@map("reconciliation_discrepancies")
}

enum RefundStatus {
  PENDING // accepted, not yet sent to gateway
  PROCESSING // gateway call in flight (or queued retry)
  SUCCEEDED // gateway confirmed, ledger reversal written
  FAILED // gateway rejected after retries — no ledger impact
}

model Refund {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  merchantId    String // denormalized for merchant-scoped queries

  amount Int // paise — matches Int used across your schema
  status RefundStatus @default(PENDING)
  reason String?

  gatewayRefundRef String?
  failureReason    String?
  attempts         Int     @default(0)

  idempotencyKey String @unique

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  ledgerEntries LedgerEntry[]

  @@index([transactionId])
  @@index([merchantId, createdAt])
  @@map("refunds")
}
