# Copy to api-py/.env (git-ignored). docker compose overrides DATABASE_URL / REDIS_URL.
DATABASE_URL=postgresql://nexpay:nexpay_dev@localhost:5432/nexpay
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
NODE_ENV=development   # "production" adds Secure to the refresh cookie (name kept from Express)
